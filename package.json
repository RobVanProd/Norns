{
  "name": "norns",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NORNS: Threads of Fate — a 32-bit-style creature-guiding puzzle game built on Three.js",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "level:png": "tsx scripts/levelpng.ts",
    "level:trace": "tsx scripts/trace.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.56.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
